<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>CoinStack</RootNamespace>
    <AssemblyName>CoinStack</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Blazor-ApexCharts" Version="7.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CoinStack.Core\CoinStack.Core.csproj" />
    <ProjectReference Include="..\CoinStack.Data\CoinStack.Data.csproj" />
  </ItemGroup>

  <!--
    wwwroot/tailadmin/style.css is built by Tailwind from the classes used in Components. It is committed,
    so the app builds without Node. After `npm install` in this folder, every build regenerates it when a
    .razor file or the Tailwind source has changed, so a new class can't go missing again.
  -->
  <ItemGroup>
    <Content Remove="package.json;package-lock.json" />
    <TailwindInput Include="Components/**/*.razor;wwwroot/tailadmin/src/css/style.css" />
  </ItemGroup>

  <Target Name="BuildTailwindCss" BeforeTargets="BeforeBuild" Condition="Exists('node_modules')"
          Inputs="@(TailwindInput)" Outputs="wwwroot/tailadmin/style.css">
    <Exec Command="npm run css --silent" />
  </Target>

</Project>