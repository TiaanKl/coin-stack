@page "/debt"
@rendermode InteractiveServer
@using CoinStack.Data.Entities
@using CoinStack.Services
@inject IDebtCalculatorEngine Calculator
@inject IDailyCatchUpService CatchUp
@inject IDebtService DebtService
@inject IAccountService AccountService
@inject ISettingsService SettingsService
@inject ITransactionService TransactionService
@inject ICategoryService CategoryService
@inject IJSRuntime JS

<PageTitle>Debt Calculator</PageTitle>

<div class="space-y-6">
    <div class="mb-2">
        <h2 class="text-xl font-semibold text-gray-800 dark:text-white/90">Debt Calculator</h2>
        <p class="text-sm text-gray-500 dark:text-gray-400">Calculate and infer debt values across simple, compound,
            amortizing, and fixed-payment contracts with nullable inputs.</p>
        </div>

        <div class="grid grid-cols-1 gap-6 xl:grid-cols-12">
            <div class="xl:col-span-5">
                <div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-white/3">
                    <h3 class="mb-4 text-base font-semibold text-gray-800 dark:text-white/90">Input Parameters</h3>

                    <form class="space-y-4" @onsubmit="CalculateAsync">
                        <div>
                            <label class="mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400">Personal
                                Interest Type</label>
                                <div class="flex flex-wrap gap-2">
                                    <button type="button"
                                            @onclick="() => SelectPersonalDebtInterestType(PersonalDebtInterestType.Fixed)"
                                            class="@(GetDebtInterestTypeChipClass(PersonalDebtInterestType.Fixed))">Fixed</button>
                                    <button type="button"
                                            @onclick="() => SelectPersonalDebtInterestType(PersonalDebtInterestType.Variable)"
                                            class="@(GetDebtInterestTypeChipClass(PersonalDebtInterestType.Variable))">Variable</button>
                                    <button type="button"
                                            @onclick="() => SelectPersonalDebtInterestType(PersonalDebtInterestType.Apr)"
                                            class="@(GetDebtInterestTypeChipClass(PersonalDebtInterestType.Apr))">APR</button>
                                    <button type="button"
                                            @onclick="() => SelectPersonalDebtInterestType(PersonalDebtInterestType.Simple)"
                                            class="@(GetDebtInterestTypeChipClass(PersonalDebtInterestType.Simple))">Simple</button>
                                    <button type="button"
                                            @onclick="() => SelectPersonalDebtInterestType(PersonalDebtInterestType.Compound)"
                                            class="@(GetDebtInterestTypeChipClass(PersonalDebtInterestType.Compound))">Compound</button>
                                    <button type="button"
                                            @onclick="() => SelectPersonalDebtInterestType(PersonalDebtInterestType.None)"
                                            class="@(GetDebtInterestTypeChipClass(PersonalDebtInterestType.None))">No
                                        Interest</button>
                                    </div>
                                </div>

                                <div
                                    class="rounded-xl border border-gray-200 bg-gray-50 p-3 dark:border-gray-700 dark:bg-gray-800/60">
                                    <p class="text-sm font-semibold text-gray-800 dark:text-white/90">Selected:
                                        @GetSelectedDebtInterestTitle()</p>
                                        <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">@GetSelectedDebtInterestDescription()
                                        </p>
                                        <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">@GetSelectedDebtInterestExample()</p>
                                    </div>

                                    @if (ShouldShowDebtCompounding())
                                    {
                                        <div>
                                            <label class="mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400">Compounding
                                                Frequency</label>
                                                <select @bind="_model.CompoundingFrequency"
                                                        class="h-11 w-full rounded-md border border-gray-300 bg-transparent px-4 py-2 text-sm text-gray-900 focus:border-brand-600 focus:outline-none focus:ring-0 dark:border-gray-600 dark:bg-gray-700 dark:text-white dark:focus:border-brand-400">
                                                    <option value="@DebtCompoundingFrequency.Monthly">Monthly</option>
                                                    <option value="@DebtCompoundingFrequency.Daily">Daily</option>
                                                    <option value="@DebtCompoundingFrequency.Annual">Annual</option>
                                                </select>
                                            </div>
                                        }
                    else
                                        {
                                            <p class="text-xs text-gray-500 dark:text-gray-400">@GetDebtCompoundingNote()</p>
                                        }

                                        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                                            <div>
                                                <label class="mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400">Principal
                                                    (optional)</label>
                                                    <InputNumber TValue="decimal?" @bind-Value="_model.Principal"
                                                                 class="peer block w-full rounded-md border border-gray-300 bg-transparent px-4 py-3 text-sm text-gray-900 focus:border-brand-600 focus:outline-none focus:ring-0 dark:border-gray-600 dark:bg-gray-700 dark:text-white dark:focus:border-brand-400" />
                                                </div>
                                                <div>
                                                    <label class="mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400">Total Owed
                                                        (optional)</label>
                                                        <InputNumber TValue="decimal?" @bind-Value="_model.TotalOwed"
                                                                     class="peer block w-full rounded-md border border-gray-300 bg-transparent px-4 py-3 text-sm text-gray-900 focus:border-brand-600 focus:outline-none focus:ring-0 dark:border-gray-600 dark:bg-gray-700 dark:text-white dark:focus:border-brand-400" />
                                                    </div>
                                                </div>

                                                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                                                    <div>
                                                        <label
                                                        class="mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400">@GetDebtRateLabel()</label>
                                                        <InputNumber TValue="decimal?" @bind-Value="_model.AnnualRatePercent"
                                                                     class="peer block w-full rounded-md border border-gray-300 bg-transparent px-4 py-3 text-sm text-gray-900 focus:border-brand-600 focus:outline-none focus:ring-0 dark:border-gray-600 dark:bg-gray-700 dark:text-white dark:focus:border-brand-400" />
                                                        <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">@GetDebtRateHelpText()</p>
                                                    </div>
                                                    <div>
                                                        <label class="mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400">Monthly
                                                            Payment (optional)</label>
                                                            <InputNumber TValue="decimal?" @bind-Value="_model.MonthlyPayment"
                                                                         class="peer block w-full rounded-md border border-gray-300 bg-transparent px-4 py-3 text-sm text-gray-900 focus:border-brand-600 focus:outline-none focus:ring-0 dark:border-gray-600 dark:bg-gray-700 dark:text-white dark:focus:border-brand-400" />
                                                        </div>
                                                    </div>

                                                    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                                                        <div>
                                                            <label class="mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400">Term Months
                                                                (optional)</label>
                                                                <InputNumber TValue="int?" @bind-Value="_model.TermMonths"
                                                                             class="peer block w-full rounded-md border border-gray-300 bg-transparent px-4 py-3 text-sm text-gray-900 focus:border-brand-600 focus:outline-none focus:ring-0 dark:border-gray-600 dark:bg-gray-700 dark:text-white dark:focus:border-brand-400" />
                                                            </div>
                                                            <div>
                                                                <label class="mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400">Payments
                                                                    Made (optional)</label>
                                                                    <InputNumber TValue="int?" @bind-Value="_model.PaymentsMade"
                                                                                 class="peer block w-full rounded-md border border-gray-300 bg-transparent px-4 py-3 text-sm text-gray-900 focus:border-brand-600 focus:outline-none focus:ring-0 dark:border-gray-600 dark:bg-gray-700 dark:text-white dark:focus:border-brand-400" />
                                                                </div>
                                                            </div>

                                                            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                                                                <div>
                                                                    <label class="mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400">Start Date
                                                                        (optional)</label>
                                                                        <InputDate TValue="DateTime?" @bind-Value="_model.StartDate"
                                                                                   class="peer block w-full rounded-md border border-gray-300 bg-transparent px-4 py-3 text-sm text-gray-900 focus:border-brand-600 focus:outline-none focus:ring-0 dark:border-gray-600 dark:bg-gray-700 dark:text-white dark:focus:border-brand-400" />
                                                                    </div>
                                                                    <div>
                                                                        <label class="mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400">End Date
                                                                            (optional)</label>
                                                                            <InputDate TValue="DateTime?" @bind-Value="_model.EndDate"
                                                                                       class="peer block w-full rounded-md border border-gray-300 bg-transparent px-4 py-3 text-sm text-gray-900 focus:border-brand-600 focus:outline-none focus:ring-0 dark:border-gray-600 dark:bg-gray-700 dark:text-white dark:focus:border-brand-400" />
                                                                        </div>
                                                                    </div>

                                                                    @if (_result is not null && _result.Errors.Count > 0)
                                                                    {
                                                                        <div
                                                                            class="rounded-xl border border-error-200 bg-error-50 px-3 py-2 text-sm text-error-700 dark:border-error-500/40 dark:bg-error-500/10 dark:text-error-400">
                                                                            @foreach (var error in _result.Errors)
                                                                            {
                                                                                <p>@error</p>
                                                                            }
                                                                        </div>
                                                                    }

                                                                    <div class="flex gap-3">
                                                                        <button type="submit"
                                                                                class="inline-flex flex-1 items-center justify-center rounded-full bg-brand-500 px-4 py-3 text-sm font-medium text-white shadow-theme-xs hover:bg-brand-600">
                                                                            Calculate
                                                                        </button>
                                                                        <button type="button" @onclick="ResetForm"
                                                                                class="inline-flex items-center justify-center rounded-full border border-gray-300 bg-white px-4 py-3 text-sm font-medium text-gray-700 shadow-theme-xs hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-300">
                                                                            Reset
                                                                        </button>
                                                                    </div>
                                                                </form>
                                                            </div>
                                                        </div>

                                                        <div class="xl:col-span-7">
                                                            <div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-white/3">
                                                                <h3 class="mb-4 text-base font-semibold text-gray-800 dark:text-white/90">Calculation Output</h3>

                                                                @if (_result is null)
                                                                {
                                                                    <div class="flex min-h-[220px] items-center justify-center rounded-xl bg-gray-50 dark:bg-gray-800">
                                                                        <p class="text-sm text-gray-500 dark:text-gray-400">No data available</p>
                                                                    </div>
                                                                }
                                                                else if (!_result.IsValid)
                                                                {
                                                                    <div
                                                                        class="flex min-h-[220px] items-center justify-center rounded-xl bg-error-50 px-6 text-center dark:bg-error-500/10">
                                                                        <p class="text-sm text-error-700 dark:text-error-400">Please correct the validation errors and
                                                                            calculate again.</p>
                                                                        </div>
                                                                }
                                                                else
                                                                {
                                                                        <div class="space-y-4">
                                                                            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                                                                                <div class="rounded-xl bg-gray-50 p-3 dark:bg-gray-800/70">
                                                                                    <p class="text-xs text-gray-500 dark:text-gray-400">Resolved Debt Type</p>
                                                                                    <p class="font-semibold text-gray-800 dark:text-white/90">@_result.ResolvedInterestType</p>
                                                                                </div>
                                                                                <div class="rounded-xl bg-gray-50 p-3 dark:bg-gray-800/70">
                                                                                    <p class="text-xs text-gray-500 dark:text-gray-400">Formula Applied</p>
                                                                                    <p class="font-semibold text-gray-800 dark:text-white/90">@_result.FormulaUsed</p>
                                                                                </div>
                                                                            </div>

                                                                            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                                                                                <div class="rounded-xl bg-gray-50 p-3 dark:bg-gray-800/70">
                                                                                    <p class="text-xs text-gray-500 dark:text-gray-400">Principal</p>
                                                                                    <p class="font-semibold text-gray-800 dark:text-white/90">@FormatCurrency(_result.Principal)
                                                                                    </p>
                                                                                </div>
                                                                                <div class="rounded-xl bg-gray-50 p-3 dark:bg-gray-800/70">
                                                                                    <p class="text-xs text-gray-500 dark:text-gray-400">Total Owed</p>
                                                                                    <p class="font-semibold text-gray-800 dark:text-white/90">@FormatCurrency(_result.TotalOwed)
                                                                                    </p>
                                                                                </div>
                                                                                <div class="rounded-xl bg-gray-50 p-3 dark:bg-gray-800/70">
                                                                                    <p class="text-xs text-gray-500 dark:text-gray-400">Interest Amount</p>
                                                                                    <p class="font-semibold text-gray-800 dark:text-white/90">
                                                                                        @FormatCurrency(_result.InterestAmount)</p>
                                                                                    </div>
                                                                                    <div class="rounded-xl bg-gray-50 p-3 dark:bg-gray-800/70">
                                                                                        <p class="text-xs text-gray-500 dark:text-gray-400">Monthly Payment</p>
                                                                                        <p class="font-semibold text-gray-800 dark:text-white/90">
                                                                                            @FormatCurrency(_result.MonthlyPayment)</p>
                                                                                        </div>
                                                                                        <div class="rounded-xl bg-gray-50 p-3 dark:bg-gray-800/70">
                                                                                            <p class="text-xs text-gray-500 dark:text-gray-400">Term</p>
                                                                                            <p class="font-semibold text-gray-800 dark:text-white/90">@FormatTerm(_result.TermMonths,
                                                                                                                                _result.Years)</p>
                                                                                            </div>
                                                                                            <div class="rounded-xl bg-gray-50 p-3 dark:bg-gray-800/70">
                                                                                                <p class="text-xs text-gray-500 dark:text-gray-400">Remaining Balance</p>
                                                                                                <p class="font-semibold text-gray-800 dark:text-white/90">
                                                                                                    @FormatCurrency(_result.RemainingBalanceAfterPayments)</p>
                                                                                                </div>
                                                                                                <div class="rounded-xl bg-gray-50 p-3 dark:bg-gray-800/70">
                                                                                                    <p class="text-xs text-gray-500 dark:text-gray-400">Start Date</p>
                                                                                                    <p class="font-semibold text-gray-800 dark:text-white/90">@FormatDate(_result.StartDate)</p>
                                                                                                </div>
                                                                                                <div class="rounded-xl bg-gray-50 p-3 dark:bg-gray-800/70">
                                                                                                    <p class="text-xs text-gray-500 dark:text-gray-400">End Date</p>
                                                                                                    <p class="font-semibold text-gray-800 dark:text-white/90">@FormatDate(_result.EndDate)</p>
                                                                                                </div>
                                                                                                <div class="rounded-xl bg-gray-50 p-3 dark:bg-gray-800/70">
                                                                                                    <p class="text-xs text-gray-500 dark:text-gray-400">Annual rate</p>
                                                                                                    <p class="font-semibold text-gray-800 dark:text-white/90">@FormatRate(_result.InterestRate)
                                                                                                    </p>
                                                                                                </div>
                                                                                                <div class="rounded-xl bg-gray-50 p-3 dark:bg-gray-800/70">
                                                                                                    <p class="text-xs text-gray-500 dark:text-gray-400">Monthly rate charged</p>
                                                                                                    <p class="font-semibold text-gray-800 dark:text-white/90">@FormatMonthlyRate(_result.EffectiveMonthlyRate)
                                                                                                    </p>
                                                                                                </div>
                                                                                            </div>

                                                                                            @if (_result.RateScenarios.Count > 0)
                                                                                            {
                                                                                                <div class="rounded-xl border border-gray-200 p-3 text-sm dark:border-gray-700">
                                                                                                    <p class="mb-2 font-medium text-gray-800 dark:text-white/90">If the rate changes</p>
                                                                                                    <table class="w-full text-left text-xs text-gray-600 dark:text-gray-300">
                                                                                                        <thead>
                                                                                                            <tr class="text-gray-500 dark:text-gray-400">
                                                                                                                <th class="py-1 font-medium">Rate</th>
                                                                                                                <th class="py-1 text-right font-medium">Monthly payment</th>
                                                                                                                <th class="py-1 text-right font-medium">Total interest</th>
                                                                                                            </tr>
                                                                                                        </thead>
                                                                                                        <tbody>
                                                                                                            @foreach (var scenario in _result.RateScenarios)
                                                                                                            {
                                                                                                                <tr>
                                                                                                                    <td class="py-1">@FormatRate(scenario.AnnualRate) (@scenario.RateChangePercentPoints.ToString("+0.##;-0.##") pt)</td>
                                                                                                                    <td class="py-1 text-right">@FormatCurrency(scenario.MonthlyPayment)</td>
                                                                                                                    <td class="py-1 text-right">@FormatCurrency(scenario.InterestAmount)</td>
                                                                                                                </tr>
                                                                                                            }
                                                                                                        </tbody>
                                                                                                    </table>
                                                                                                </div>
                                                                                            }

                                                                                            @if (_result.Inferences.Count > 0)
                                                                                            {
                                                                                                <div
                                                                                                    class="rounded-xl border border-success-200 bg-success-50 p-3 text-sm text-success-700 dark:border-success-500/40 dark:bg-success-500/10 dark:text-success-400">
                                                                                                    <p class="mb-1 font-medium">Inferences made</p>
                                                                                                    @foreach (var inference in _result.Inferences)
                                                                                                    {
                                                                                                        <p>• @inference</p>
                                                                                                    }
                                                                                                </div>
                                                                                            }

                                                                                            @if (_result.Warnings.Count > 0)
                                                                                            {
                                                                                                <div
                                                                                                    class="rounded-xl border border-warning-200 bg-warning-50 p-3 text-sm text-warning-700 dark:border-warning-500/40 dark:bg-warning-500/10 dark:text-warning-400">
                                                                                                    <p class="mb-1 font-medium">Warnings</p>
                                                                                                    @foreach (var warning in _result.Warnings)
                                                                                                    {
                                                                                                        <p>• @warning</p>
                                                                                                    }
                                                                                                </div>
                                                                                            }
                                                                                        </div>
                                                                                    }
                                                                                </div>
                                                                            </div>
                                                                        </div>

                                                                        <div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-white/3">
                                                                            <div class="mb-4 flex items-center justify-between gap-3">
                                                                                <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">Saved Debt Cards</h3>
                                                                                <div class="flex flex-wrap items-center gap-2">
                                                                                    <a href="/debt-simulator"
                                                                                       class="inline-flex items-center justify-center rounded-full border border-brand-300 bg-brand-50 px-4 py-2 text-sm font-medium text-brand-700 shadow-theme-xs hover:bg-brand-100 dark:border-brand-500/40 dark:bg-brand-500/10 dark:text-brand-400">
                                                                                        Simulate Payoff →
                                                                                    </a>
                                                                                    <button type="button" @onclick="OpenCreateDebtModal"
                                                                                            class="inline-flex items-center justify-center rounded-full bg-brand-500 px-4 py-2 text-sm font-medium text-white shadow-theme-xs hover:bg-brand-600">
                                                                                        + Add Debt
                                                                                    </button>
                                                                                </div>
                                                                            </div>

                                                                            @if (_isDebtLoading)
                                                                            {
                                                                                <div class="flex min-h-[180px] items-center justify-center rounded-xl bg-gray-50 dark:bg-gray-800">
                                                                                    <p class="text-sm text-gray-500 dark:text-gray-400">Loading debt cards...</p>
                                                                                </div>
                                                                            }
                                                                            else if (_savedDebts.Count == 0)
                                                                            {
                                                                                <div class="flex min-h-[180px] items-center justify-center rounded-xl bg-gray-50 dark:bg-gray-800">
                                                                                    <p class="text-sm text-gray-500 dark:text-gray-400">No debt cards yet.</p>
                                                                                </div>
                                                                            }
                                                                            else
                                                                            {
                                                                                <div class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3">
                                                                                    @foreach (var debt in _savedDebts)
                                                                                    {
                                                                                        var progressPercent = GetProgressPercent(debt);
                                                                                        <div class="rounded-xl border border-gray-100 p-4 dark:border-gray-800">
                                                                                            <div class="mb-3 flex items-start justify-between gap-2">
                                                                                                <div>
                                                                                                    <h4 class="text-sm font-semibold text-gray-800 dark:text-white/90">@debt.Name</h4>
                                                                                                    <p class="text-xs text-gray-500 dark:text-gray-400">@(string.IsNullOrWhiteSpace(debt.Provider) ?
                                                                                                                             "No provider" : debt.Provider)</p>
                                                                                                    @if (_cardByDebt.TryGetValue(debt.Id, out var linkedCard))
                                                                                                    {
                                                                                                        <a href="/accounts" class="text-xs text-brand-600 hover:underline dark:text-brand-400"><i class="fa-solid fa-credit-card text-[10px]"></i> Follows @linkedCard.Name</a>
                                                                                                    }
                                                                                                    </div>
                                                                                                    <span
                                                                                                        class="rounded-md bg-gray-100 px-2 py-1 text-xs text-gray-600 dark:bg-gray-800 dark:text-gray-300">@debt.InterestRatePercent.ToString("0.##")%
                                                                                                        APR</span>
                                                                                                    </div>

                                                                                                    <div class="mb-2 flex items-end justify-between">
                                                                                                        <p class="text-lg font-bold text-gray-800 dark:text-white/90">@FormatCurrency(debt.CurrentBalance)</p>
                                                                                                        <p class="text-xs text-gray-500 dark:text-gray-400">of @FormatCurrency(debt.TotalAmount)</p>
                                                                                                    </div>

                                                                                                    <div class="mb-2 h-2.5 w-full rounded-full bg-gray-200 dark:bg-gray-800">
                                                                                                        <div class="h-2.5 rounded-full bg-brand-500 transition-all"
                                                                                                             style="width: @progressPercent.ToString("F0")%;"></div>
                                                                                                    </div>
                                                                                                    <p class="mb-3 text-xs text-gray-500 dark:text-gray-400">@progressPercent.ToString("F0")% paid off</p>

                                                                                                    <div class="grid grid-cols-2 gap-2 text-xs text-gray-500 dark:text-gray-400">
                                                                                                        <p>Monthly: <span
                                                                                                            class="font-medium text-gray-700 dark:text-gray-300">@FormatCurrency(debt.MonthlyPaymentAmount)</span>
                                                                                                        </p>
                                                                                                        <p>Start: <span
                                                                                                            class="font-medium text-gray-700 dark:text-gray-300">@debt.PaymentStartDateUtc.ToString("dd MMM yyyy")</span></p>
                                                                                                        </div>

                                                                                                        @if (_paymentDebtId == debt.Id)
                                                                                                        {
                                                                                                            <form class="mt-3 space-y-2" @onsubmit="() => RecordPaymentAsync(debt)">
                                                                                                                <label class="block text-xs font-medium text-gray-700 dark:text-gray-400">Payment amount</label>
                                                                                                                <InputNumber TValue="decimal?" @bind-Value="_paymentAmount" min="0.01" step="0.01"
                                                                                                                             class="block w-full rounded-md border border-gray-300 bg-transparent px-3 py-2 text-sm text-gray-900 focus:border-brand-600 focus:outline-none focus:ring-0 dark:border-gray-600 dark:bg-gray-700 dark:text-white" />
                                                                                                                <p class="text-xs text-gray-500 dark:text-gray-400">
                                                                                                                    @(_cardByDebt.ContainsKey(debt.Id)
                                                                                                                        ? "Moved from your main account to the card today, which lowers this balance."
                                                                                                                        : "Logged as a Debt expense today and taken off this balance.")
                                                                                                                </p>
                                                                                                                @if (!string.IsNullOrEmpty(_paymentError))
                                                                                                                {
                                                                                                                    <p class="text-xs text-error-600 dark:text-error-400">@_paymentError</p>
                                                                                                                }
                                                                                                                <div class="flex justify-end gap-2">
                                                                                                                    <button type="button" @onclick="CancelRecordPayment"
                                                                                                                            class="inline-flex items-center justify-center rounded-full border border-gray-300 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-300">
                                                                                                                        Cancel
                                                                                                                    </button>
                                                                                                                    <button type="submit"
                                                                                                                            class="inline-flex items-center justify-center rounded-full bg-brand-500 px-3 py-1.5 text-xs font-medium text-white hover:bg-brand-600">
                                                                                                                        Save payment
                                                                                                                    </button>
                                                                                                                </div>
                                                                                                            </form>
                                                                                                        }
                                                                                                        else
                                                                                                        {
                                                                                                            <div class="mt-3 flex flex-wrap justify-end gap-2">
                                                                                                                <button type="button" @onclick="() => LoadDebtIntoCalculator(debt)"
                                                                                                                        class="inline-flex items-center justify-center rounded-full border border-gray-300 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-300">
                                                                                                                    Calculate payoff
                                                                                                                </button>
                                                                                                                <button type="button" @onclick="() => OpenRecordPayment(debt)"
                                                                                                                        class="inline-flex items-center justify-center rounded-full border border-brand-300 bg-brand-50 px-3 py-1.5 text-xs font-medium text-brand-700 hover:bg-brand-100 dark:border-brand-500/40 dark:bg-brand-500/10 dark:text-brand-400">
                                                                                                                    Record payment
                                                                                                                </button>
                                                                                                                <button type="button" @onclick="() => OpenEditDebtModal(debt)"
                                                                                                                        class="inline-flex items-center justify-center rounded-full border border-gray-300 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-300">
