@page "/bank-import"
@rendermode InteractiveServer
@using CoinStack.Data.Entities
@using CoinStack.Services
@using CoinStack.Services.Import
@inject IAccountService AccountService
@inject IBankStatementImportService ImportService
@inject IProjectionService ProjectionService
@inject ISettingsService SettingsService
@inject ICategoryService CategoryService
@inject IGameFeedbackService GameFeedbackService
@inject IJSRuntime JS

<PageTitle>Bank Import & Intelligence</PageTitle>

<div>
    <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
        <div>
            <h2 class="text-xl font-semibold text-gray-800 dark:text-white/90">Bank Statement Import & Intelligence</h2>
            <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
                Upload FNB <strong>transaction history</strong> (CSV or OFX) for the missing weeks — monthly PDF statements often stop a month or two behind. History lives under the account in the FNB app or online banking (Transactions → Download), not under Documents → Statements.
            </p>
        </div>

        <div class="flex flex-wrap items-center gap-2">
            <button type="button" @onclick="() => _showUpdateBalanceModal = true"
                    class="inline-flex items-center gap-2 rounded-full border border-gray-200 bg-white px-5 py-2.5 text-sm font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:bg-white/[0.03] dark:text-gray-300 dark:hover:bg-white/[0.06]">
                <i class="fa-solid fa-pen-to-square text-xs"></i>
                Update Balance
            </button>
            @if (_preview is not null)
            {
                <button type="button" @onclick="Reset"
                        class="inline-flex items-center gap-2 rounded-full border border-gray-200 bg-white px-5 py-2.5 text-sm font-medium text-gray-600 hover:bg-gray-50 dark:border-gray-700 dark:bg-white/[0.03] dark:text-gray-300 dark:hover:bg-white/[0.06]">
                    <i class="fa-solid fa-rotate-left"></i>
                    New Import
                </button>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="mb-6 flex items-center gap-3 rounded-2xl border border-error-200 bg-error-50 px-5 py-4 dark:border-error-500/30 dark:bg-error-500/10">
            <i class="fa-solid fa-circle-exclamation text-error-600 dark:text-error-400"></i>
            <span class="text-sm text-error-700 dark:text-error-400">@_error</span>
            <button type="button" @onclick="() => _error = null" class="ml-auto text-error-500 hover:text-error-600">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
    }

    @if (_result is not null)
    {
        <div class="mb-6 flex items-center gap-3 rounded-2xl border border-success-200 bg-success-50 px-5 py-4 dark:border-success-500/30 dark:bg-success-500/10">
            <i class="fa-solid fa-circle-check text-success-600 dark:text-success-400"></i>
            <span class="text-sm text-success-700 dark:text-success-400">
                Imported @_result.ImportedCount transactions
                @if (_result.DuplicateCount > 0)
                {
                    <text> · @_result.DuplicateCount duplicates skipped</text>
                }
                @if (_result.TransfersRecorded > 0)
                {
                    <text> · @_result.TransfersRecorded transfers between your accounts recorded</text>
                }
                @if (_result.TransferCount > 0)
                {
                    <text> · @_result.TransferCount transfers left out</text>
                }
                @if (_result.BalanceUpdated && _result.ClosingBalance is { } closingBalance)
                {
                    <text> · Account balance set to @Money(closingBalance)</text>
                }
                else if (_result.ClosingBalance is not null)
                {
                    <text> · Account balance kept — a newer balance is already on file</text>
                }
                @if (!_result.SettingsUpdated)
                {
                    <text> · Older statement: income and payday left unchanged</text>
                }
                @if (_result.DetectedMonthlySalary is > 0)
                {
                    <text> · Base monthly salary anchored to @Money(_result.DetectedMonthlySalary.Value)</text>
                }
                @if (_result.BucketsCreated > 0)
                {
                    <text> · @_result.BucketsCreated bucket(s) created</text>
                }
                @if (_result.SubscriptionsCreated > 0)
                {
                    <text> · @_result.SubscriptionsCreated subscription(s) created</text>
                }
                @if (_result.SubscriptionsLinked > 0)
                {
                    <text> · @_result.SubscriptionsLinked existing subscription(s) linked</text>
                }
            </span>
            <button type="button" @onclick="() => _result = null" class="ml-auto text-success-500 hover:text-success-600">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
    }

    <!-- ===== Projections & Cash Flow Overview ===== -->
    <div class="mb-6 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
        <div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-white/[0.03]">
            <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-full bg-success-50 text-success-600 dark:bg-success-500/10 dark:text-success-400">
                    <i class="fa-solid fa-arrow-trend-up"></i>
                </div>
                <div>
                    <p class="text-xs text-gray-500 dark:text-gray-400">Projected monthly income</p>
                    <p class="text-xl font-semibold text-gray-800 dark:text-white/90">@Money(_projection?.ProjectedMonthlyIncome ?? 0m)</p>
                </div>
            </div>
            @if (_projection is not null && _projection.RecurringIncome.Count > 0)
            {
                <p class="mt-3 text-xs text-gray-500 dark:text-gray-400">
                    @_projection.RecurringIncome.Count recurring sources · @Money(_projection.RecurringIncomeTotal) stable
                </p>
            }
        </div>

        <div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-white/[0.03]">
            <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-full bg-error-50 text-error-600 dark:bg-error-500/10 dark:text-error-400">
                    <i class="fa-solid fa-arrow-trend-down"></i>
                </div>
                <div>
                    <p class="text-xs text-gray-500 dark:text-gray-400">Projected monthly expenses</p>
                    <p class="text-xl font-semibold text-gray-800 dark:text-white/90">@Money(_projection?.ProjectedMonthlyExpenses ?? 0m)</p>
                </div>
            </div>
            @if (_projection is not null && _projection.RecurringExpenses.Count > 0)
            {
                <p class="mt-3 text-xs text-gray-500 dark:text-gray-400">
                    @_projection.RecurringExpenses.Count recurring charges · @Money(_projection.RecurringExpenseTotal) stable
                </p>
            }
        </div>

        <div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-white/[0.03]">
            <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-full bg-brand-50 text-brand-600 dark:bg-brand-500/10 dark:text-brand-400">
                    <i class="fa-solid fa-scale-balanced"></i>
                </div>
                <div>
                    <p class="text-xs text-gray-500 dark:text-gray-400">Projected net / month</p>
                    @{
                        var net = _projection?.ProjectedMonthlyNet ?? 0m;
                    }
                    <p class="text-xl font-semibold @(net >= 0 ? "text-success-600 dark:text-success-400" : "text-error-600 dark:text-error-400")">
                        @Money(net)
                    </p>
                </div>
            </div>
            @if (_projection is not null && _projection.MonthsOfData > 0)
            {
                <p class="mt-3 text-xs text-gray-500 dark:text-gray-400">
                    @(_projection.ProjectedMonthlyNet >= 0 ? "Surplus" : "Shortfall")
                    @(_projection.SavingsRatePercent.ToString("N1"))% of income · @_projection.MonthsOfData month(s) of bank data
                </p>
            }
            else
            {
                <p class="mt-3 text-xs text-gray-500 dark:text-gray-400">Upload statements to start projecting</p>
            }
        </div>

        <div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-white/[0.03]">
            <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-full bg-warning-50 text-warning-600 dark:bg-warning-500/10 dark:text-warning-400">
                    <i class="fa-solid fa-file-invoice"></i>
                </div>
                <div>
                    <p class="text-xs text-gray-500 dark:text-gray-400">Statements imported</p>
                    <p class="text-xl font-semibold text-gray-800 dark:text-white/90">@_history.Count(i => i.Status == StatementImportStatus.Imported)</p>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== Charts & Top Monthly Services Breakdown ===== -->
    <div class="mb-6 grid grid-cols-1 gap-6 lg:grid-cols-3">
        <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03] lg:col-span-2">
            <div class="border-b border-gray-100 px-6 py-5 dark:border-gray-800">
                <h3 class="text-base font-medium text-gray-800 dark:text-white/90">Income vs Expenses (Cash Flow)</h3>
                <p class="mt-0.5 text-xs text-gray-500 dark:text-gray-400">Historical completed months & forward projection</p>
            </div>
            <div class="p-6">
                @if (_chartData.Count == 0)
                {
                    <div class="text-sm text-gray-500 dark:text-gray-400">Import at least one statement to see your cash flow.</div>
                }
                else
                {
                    <ApexChart TItem="MonthChartPoint" Title="" Height="300">
                        <ApexPointSeries TItem="MonthChartPoint"
                                         Items="_chartData"
                                         Name="Income"
                                         XValue="@(e => e.Label)"
                                         YValue="@(e => e.Income)"
                                         SeriesType="SeriesType.Bar" />
                        <ApexPointSeries TItem="MonthChartPoint"
                                         Items="_chartData"
                                         Name="Expenses"
                                         XValue="@(e => e.Label)"
                                         YValue="@(e => e.Expenses)"
                                         SeriesType="SeriesType.Bar" />
                    </ApexChart>
                }
            </div>
        </div>

        <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-800 dark:bg-white/[0.03]">
            <div class="flex items-center justify-between border-b border-gray-100 pb-4 dark:border-gray-800">
                <div>
                    <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">Top Monthly Services</h3>
                    <p class="text-xs text-gray-500 dark:text-gray-400">Normalized spend across subscriptions & vendors</p>
                </div>
            </div>

            <div class="mt-4 max-h-[300px] space-y-3 overflow-y-auto pr-1">
                @if (_projection is not null && _projection.TopMerchants.Count > 0)
                {
                    @foreach (var merchant in _projection.TopMerchants.Take(6))
                    {
                        <div class="flex items-center justify-between rounded-xl bg-gray-50/80 p-3 transition-colors hover:bg-gray-100/80 dark:bg-white/[0.02] dark:hover:bg-white/[0.04]">
                            <div class="flex items-center gap-3 min-w-0">
                                <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-brand-50 text-brand-600 dark:bg-brand-500/10 dark:text-brand-400">
                                    <i class="@merchant.IconClass text-sm"></i>
                                </div>
                                <div class="min-w-0">
                                    <p class="truncate text-sm font-medium text-gray-800 dark:text-white/90">@merchant.MerchantName</p>
                                    <p class="text-[11px] text-gray-500 dark:text-gray-400">@merchant.CategoryName · @merchant.TransactionCount tx</p>
                                </div>
                            </div>
                            <div class="text-right shrink-0">
                                <p class="text-sm font-semibold text-gray-800 dark:text-white/90">@Money(merchant.TotalAmount)</p>
                                <p class="text-[11px] text-gray-400">~@Money(merchant.MonthlyAverage)/mo</p>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="py-8 text-center text-xs text-gray-400">No merchant history yet. Upload a statement below.</p>
                }
            </div>
        </div>
    </div>

    @if (_preview is not null && _preview.RecurringProposals.Count > 0)
    {
        <div class="mb-6 rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
            <div class="border-b border-gray-100 px-6 py-5 dark:border-gray-800">
                <h3 class="text-base font-medium text-gray-800 dark:text-white/90">Will create from this import</h3>
                <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Uncheck anything that is not a real bill. High-confidence recurrings are selected by default.</p>
            </div>
            <div class="overflow-x-auto p-4">
                <table class="min-w-full text-sm">
                    <thead>
                        <tr class="text-left text-xs text-gray-500">
                            <th class="px-3 py-2">Subscription</th>
                            <th class="px-3 py-2">Bucket</th>
                            <th class="px-3 py-2">Merchant</th>
                            <th class="px-3 py-2">Typical amount</th>
                            <th class="px-3 py-2">Cycle</th>
                            <th class="px-3 py-2">Debit day</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var proposal in _preview.RecurringProposals)
                        {
                            <tr class="border-t border-gray-100 dark:border-gray-800">
                                <td class="px-3 py-2">
                                    <input type="checkbox" @bind="proposal.CreateSubscription" />
                                </td>
                                <td class="px-3 py-2">
                                    <input type="checkbox" @bind="proposal.CreateBucket" />
                                </td>
                                <td class="px-3 py-2 text-gray-800 dark:text-white/90">
                                    @proposal.MerchantName
                                    @if (proposal.SubscriptionExists || proposal.BucketExists)
                                    {
                                        <span class="ml-1 text-xs text-gray-500 dark:text-gray-400">(already set up: transactions are linked, its amounts are left as you set them)</span>
                                    }
                                </td>
                                <td class="px-3 py-2">@Money(proposal.MedianAmount)</td>
                                <td class="px-3 py-2">@SubscriptionCosts.CycleLabel(proposal.Cycle)</td>
                                <td class="px-3 py-2">@proposal.DebitOrderDay</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (_preview is null)
    {
        <!-- ===== Upload zone ===== -->
        <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
            <div class="border-b border-gray-100 px-6 py-5 dark:border-gray-800">
                <h3 class="text-base font-medium text-gray-800 dark:text-white/90">Upload Statements</h3>
            </div>

            <div class="p-6">
                <label class="flex cursor-pointer flex-col items-center justify-center rounded-2xl border-2 border-dashed border-gray-200 px-6 py-12 text-center transition-colors hover:border-brand-400 dark:border-gray-700 dark:hover:border-brand-500">
                    <InputFile OnChange="OnFilesSelectedAsync" accept=".pdf,.csv,.ofx,.qfx" multiple hidden />
                    <i class="fa-solid fa-file-pdf mb-3 text-4xl text-brand-500"></i>
                    @if (_isParsing)
                    {
                        <span class="text-sm font-medium text-gray-700 dark:text-gray-300">
                            <i class="fa-solid fa-spinner fa-spin mr-2"></i>Parsing statement & grouping services…
                        </span>
                    }
                    else
                    {
                        <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Click to upload FNB PDFs, CSV, or OFX</span>
                        <span class="mt-1 text-xs text-gray-400 dark:text-gray-500">Use transaction history for July–now. Use the monthly PDF only for older months. CoinStack cannot log into FNB.</span>
                    }
                </label>

                @if (_history.Count > 0)
                {
                    <div class="mt-6">
                        <h4 class="mb-3 text-sm font-medium text-gray-700 dark:text-gray-300">Import history</h4>
                        <div class="divide-y divide-gray-100 dark:divide-gray-800">
                            @foreach (var import in _history)
                            {
                                <div class="flex flex-wrap items-center gap-3 py-3">
                                    <i class="fa-solid fa-file-pdf text-error-500"></i>
                                    <div class="min-w-0 flex-1">
                                        <p class="truncate text-sm font-medium text-gray-800 dark:text-white/90">
                                            @(import.PeriodStartUtc?.ToString("dd MMM yyyy") ?? "—") – @(import.PeriodEndUtc?.ToString("dd MMM yyyy") ?? "—")
                                        </p>
                                        <p class="text-xs text-gray-500 dark:text-gray-400">
                                            @AccountName(import.AccountId) · @import.TransactionsImported transactions
                                            @if (import.DuplicatesSkipped > 0)
                                            {
                                                <text> · @import.DuplicatesSkipped duplicates</text>
                                            }
                                            @if (import.TransfersSkipped > 0)
                                            {
                                                <text> · @import.TransfersSkipped transfers</text>
                                            }
                                        </p>
                                    </div>
                                    @if (import.Status == StatementImportStatus.Imported)
                                    {
                                        <span class="rounded-full bg-success-50 px-2.5 py-0.5 text-[11px] font-medium text-success-600 dark:bg-success-500/10 dark:text-success-400">Imported</span>
                                        @if (_accounts.Count > 1)
                                        {
                                            <select value="" @onchange="e => MoveImportAsync(import.Id, e.Value?.ToString())" title="Put this statement's transactions on another account"
                                                    class="rounded-full border border-gray-200 bg-white py-1 pl-3 pr-8 text-xs text-gray-500 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400">
                                                <option value="">Move to…</option>
                                                @foreach (var account in _accounts.Where(a => a.Id != (import.AccountId ?? MainAccountId)))
                                                {
                                                    <option value="@account.Id">@account.Name</option>
                                                }
                                            </select>
                                        }
                                        <button type="button" @onclick="() => RevertImportAsync(import.Id)"
                                                class="rounded-full border border-gray-200 px-3 py-1 text-xs font-medium text-gray-500 hover:bg-gray-50 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-white/[0.04]">
                                            Revert
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="rounded-full bg-gray-100 px-2.5 py-0.5 text-[11px] font-medium text-gray-500 dark:bg-white/[0.05] dark:text-gray-400">Reverted</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <!-- ===== Statement preview & Smart Intelligence ===== -->
        <div class="mb-6 rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-gray-100 px-6 py-5 dark:border-gray-800">
                <div>
                    <h3 class="text-base font-medium text-gray-800 dark:text-white/90">
                        @(_preview.BankFormat) Statement Preview
                    </h3>
                    <p class="mt-0.5 text-xs text-gray-500 dark:text-gray-400">
                        @(_preview.PeriodStartUtc?.ToString("dd MMM yyyy") ?? "—") – @(_preview.PeriodEndUtc?.ToString("dd MMM yyyy") ?? "—")
                        @if (_preview.AccountNumber is not null)
                        {
                            <text> · Account @(AccountDisplay.MaskedNumber(_preview.AccountNumber) ?? _preview.AccountNumber)</text>
                        }
                    </p>
                    @if (_preview.AccountId is not null)
                    {
                        <label class="mt-2 flex items-center gap-2 text-xs text-gray-600 dark:text-gray-300">
                            Import into
                            <select value="@_preview.AccountId" @onchange="e => ChangePreviewAccountAsync(e.Value?.ToString())"
                                    class="rounded-lg border border-gray-200 bg-white py-1 pl-2.5 pr-8 text-xs text-gray-700 focus:border-brand-500 focus:outline-none dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300">
                                @foreach (var account in _accounts)
                                {
                                    <option value="@account.Id">@account.Name</option>
                                }
                            </select>
                        </label>
                    }
                </div>

                <div class="flex flex-wrap items-center gap-2">
                    <button type="button" @onclick="Reset"
                            class="rounded-full border border-gray-200 px-4 py-2 text-sm font-medium text-gray-600 hover:bg-gray-50 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-white/[0.04]">
                        Discard
                    </button>
                    <button type="button" disabled="@(_isImporting || SelectedCount == 0 || _preview.AccountId is null)" @onclick="ImportAsync"
                            class="inline-flex items-center gap-2 rounded-full bg-brand-500 px-6 py-2.5 text-sm font-medium text-white shadow-sm hover:bg-brand-600 disabled:cursor-not-allowed disabled:opacity-50">
                        @if (_isImporting)
                        {
                            <i class="fa-solid fa-spinner fa-spin"></i>
                        }
                        else
                        {
                            <i class="fa-solid fa-file-import"></i>
                        }
                        Import @(SelectedCount) transactions
                    </button>
                </div>
            </div>

            @if (_preview.AccountId is null)
            {
                <div class="border-b border-gray-100 bg-warning-50/60 px-6 py-4 dark:border-gray-800 dark:bg-warning-500/5">
                    <p class="text-sm font-medium text-warning-800 dark:text-warning-300">
                        This statement is for account @(AccountDisplay.MaskedNumber(_preview.AccountNumber) ?? _preview.AccountNumber), which isn't set up in CoinStack yet.
                    </p>
                    <div class="mt-3 flex flex-wrap items-center gap-2 text-xs">
                        <select value="" @onchange="e => ChangePreviewAccountAsync(e.Value?.ToString())"
                                class="rounded-lg border border-gray-200 bg-white py-1.5 pl-2.5 pr-8 text-xs text-gray-700 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300">
                            <option value="">It's one of my accounts…</option>
                            @foreach (var account in _accounts)
                            {
                                <option value="@account.Id">@account.Name</option>
                            }
                        </select>
                        <span class="text-gray-500 dark:text-gray-400">or add it as a</span>
                        <select @bind="_newAccountType"
                                class="rounded-lg border border-gray-200 bg-white py-1.5 pl-2.5 pr-8 text-xs text-gray-700 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300">
                            @foreach (var type in Enum.GetValues<AccountType>())
                            {
                                <option value="@type">@AccountDisplay.Label(type)</option>
                            }
                        </select>
                        <button type="button" @onclick="AddStatementAccountAsync"
                                class="rounded-full bg-brand-500 px-4 py-1.5 font-medium text-white hover:bg-brand-600">
                            Add account
                        </button>
                    </div>
                </div>
            }

            <!-- Smart Bank Fee & Overdraft Insights -->
            @if (_preview.TotalAvoidableBankFees > 0 || _preview.PeakOverdraft < 0)
            {
                <div class="grid grid-cols-1 gap-3 border-b border-gray-100 bg-amber-50/50 p-4 md:grid-cols-2 dark:border-gray-800 dark:bg-amber-500/5">
                    @if (_preview.TotalAvoidableBankFees > 0)
                    {
                        <div class="flex items-start gap-3 rounded-xl border border-warning-200 bg-white p-3.5 shadow-sm dark:border-warning-500/30 dark:bg-gray-900/60">
                            <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-warning-100 text-warning-700 dark:bg-warning-500/20 dark:text-warning-400">
                                <i class="fa-solid fa-triangle-exclamation text-sm"></i>
                            </div>
                            <div>
                                <p class="text-xs font-semibold text-warning-800 dark:text-warning-300">
                                    Avoidable Bank Fees Detected: @Money(_preview.TotalAvoidableBankFees)
                                </p>
                                <p class="mt-0.5 text-[11px] text-gray-600 dark:text-gray-400">
                                    @_preview.AvoidableBankFeeCount fee items (unpaid item fees & declined transaction charges) were incurred during this period.
                                </p>
                            </div>
                        </div>
                    }

                    @if (_preview.PeakOverdraft < 0)
                    {
                        <div class="flex items-start gap-3 rounded-xl border border-error-200 bg-white p-3.5 shadow-sm dark:border-error-500/30 dark:bg-gray-900/60">
                            <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-error-100 text-error-700 dark:bg-error-500/20 dark:text-error-400">
                                <i class="fa-solid fa-arrow-down-long text-sm"></i>
                            </div>
                            <div>
                                <p class="text-xs font-semibold text-error-800 dark:text-error-300">
                                    Peak Overdraft: @Money(_preview.PeakOverdraft)
                                </p>
                                <p class="mt-0.5 text-[11px] text-gray-600 dark:text-gray-400">
                                    Account was overdrawn on @_preview.DaysInOverdraft days before deposits arrived.
                                </p>
                            </div>
                        </div>
                    }
                </div>
            }

            <div class="grid grid-cols-2 gap-4 border-b border-gray-100 px-6 py-4 sm:grid-cols-3 lg:grid-cols-6 dark:border-gray-800">
                <div>
                    <p class="text-[11px] text-gray-400 uppercase">Rows parsed</p>
                    <p class="text-sm font-semibold text-gray-800 dark:text-white/90">@_preview.RowsParsed</p>
                </div>
                <div>
                    <p class="text-[11px] text-gray-400 uppercase">New income</p>
                    <p class="text-sm font-semibold text-success-600 dark:text-success-400">@Money(_preview.TotalIncome)</p>
                    @if (_preview.MonthsCovered > 1)
                    {
                        <p class="text-[11px] text-gray-500 dark:text-gray-400">≈ @Money(_preview.PerMonth(_preview.TotalIncome)) a month over @_preview.MonthsCovered months</p>
                    }
                </div>
                <div>
                    <p class="text-[11px] text-gray-400 uppercase">New expenses</p>
                    <p class="text-sm font-semibold text-error-600 dark:text-error-400">@Money(_preview.TotalExpenses)</p>
                    @if (_preview.MonthsCovered > 1)
                    {
                        <p class="text-[11px] text-gray-500 dark:text-gray-400">≈ @Money(_preview.PerMonth(_preview.TotalExpenses)) a month</p>
                    }
                </div>
                <div>
                    <p class="text-[11px] text-gray-400 uppercase">Transfers</p>
                    <p class="text-sm font-semibold text-gray-500 dark:text-gray-400">@_preview.TransferCount</p>
                    @if (_preview.TransfersToRecord > 0)
                    {
                        <p class="text-[11px] text-gray-500 dark:text-gray-400">@_preview.TransfersToRecord will be recorded</p>
                    }
                </div>
                <div>
                    <p class="text-[11px] text-gray-400 uppercase">Duplicates</p>
                    <p class="text-sm font-semibold text-gray-500 dark:text-gray-400">@_preview.DuplicateCount</p>
                </div>
                <div>
                    <p class="text-[11px] text-gray-400 uppercase">Closing balance</p>
                    <p class="text-sm font-semibold @((_preview.ClosingBalance ?? 0m) >= 0 ? "text-success-600 dark:text-success-400" : "text-error-600 dark:text-error-400")">
                        @Money(_preview.ClosingBalance ?? 0m)
                    </p>
                </div>
            </div>

            @foreach (var warning in _preview.Warnings)
            {
                <div class="border-b border-gray-100 bg-warning-50 px-6 py-2 text-xs text-warning-700 dark:border-gray-800 dark:bg-warning-500/10 dark:text-warning-400">
                    <i class="fa-solid fa-triangle-exclamation mr-1"></i>@warning
                </div>
            }

            <!-- Search, Filters, and View Switcher -->
            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-gray-100 p-4 dark:border-gray-800">
                <!-- View Switcher Tabs -->
                <div class="inline-flex rounded-xl bg-gray-100 p-1 dark:bg-white/[0.05]">
                    <button type="button" @onclick="() => _viewMode = ViewMode.Grouped"
                            class="rounded-lg px-4 py-1.5 text-xs font-medium transition-all @(_viewMode == ViewMode.Grouped ? "bg-white text-gray-900 shadow-sm dark:bg-gray-800 dark:text-white" : "text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200")">
                        <i class="fa-solid fa-layer-group mr-1.5"></i>Grouped by Service (@_preview.GroupedMerchants.Count)
                    </button>
                    <button type="button" @onclick="() => _viewMode = ViewMode.Ledger"
                            class="rounded-lg px-4 py-1.5 text-xs font-medium transition-all @(_viewMode == ViewMode.Ledger ? "bg-white text-gray-900 shadow-sm dark:bg-gray-800 dark:text-white" : "text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200")">
                        <i class="fa-solid fa-list-ul mr-1.5"></i>All Transactions (@_preview.Candidates.Count)
                    </button>
                </div>

                <!-- Search & Filters -->
                <div class="flex flex-wrap items-center gap-2">
                    <div class="relative">
                        <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-xs text-gray-400"></i>
                        <input type="text" @bind="_searchTerm" @bind:event="oninput" placeholder="Search merchant..."
                               class="w-44 rounded-full border border-gray-200 bg-white py-1.5 pl-8 pr-3 text-xs text-gray-800 focus:border-brand-500 focus:outline-none dark:border-gray-700 dark:bg-gray-800 dark:text-white sm:w-56" />
                    </div>

                    <select @bind="_typeFilter" class="rounded-full border border-gray-200 bg-white py-1.5 pl-3 pr-8 text-xs text-gray-700 focus:border-brand-500 focus:outline-none dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300">
                        <option value="All">All Types</option>
                        <option value="Expense">Expenses Only</option>
                        <option value="Income">Income Only</option>
                        <option value="Transfer">Transfers Only</option>
                        <option value="AvoidableFees">Avoidable Fees Only</option>
                    </select>
                </div>
            </div>

            @if (_viewMode == ViewMode.Grouped)
            {
                <!-- ===== Grouped by Service / Merchant View ===== -->
                <div class="divide-y divide-gray-100 dark:divide-gray-800">
                    @foreach (var group in FilteredGroups)
                    {
                        var isExpanded = _expandedGroups.Contains(group.NormalizedKey);
                        <div class="transition-colors hover:bg-gray-50/50 dark:hover:bg-white/[0.01]">
                            <div class="flex flex-wrap items-center justify-between gap-3 p-4">
                                <div class="flex items-center gap-3 min-w-0">
                                    <input type="checkbox" checked="@group.AllIncluded"
                                           @onchange="() => ToggleGroup(group)"
                                           class="h-4 w-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 dark:border-gray-600 dark:bg-gray-700" />
                                    
                                    <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-gray-100 text-gray-700 dark:bg-white/[0.06] dark:text-gray-300">
                                        <i class="@group.IconClass text-base"></i>
                                    </div>

                                    <div class="min-w-0">
                                        <div class="flex flex-wrap items-center gap-2">
                                            <p class="text-sm font-semibold text-gray-800 dark:text-white/90">@group.MerchantName</p>
                                            
                                            @if (group.Type == TransactionType.Income)
                                            {
                                                <span class="rounded-full bg-success-50 px-2 py-0.5 text-[10px] font-medium text-success-600 dark:bg-success-500/10 dark:text-success-400">Income</span>
                                            }
                                            else if (group.Type == TransactionType.Transfer)
                                            {
                                                <span class="rounded-full bg-gray-100 px-2 py-0.5 text-[10px] font-medium text-gray-500 dark:bg-white/[0.05] dark:text-gray-400">Transfer</span>
                                            }

                                            @if (group.IsAvoidableFee)
                                            {
                                                <span class="rounded-full bg-warning-100 px-2 py-0.5 text-[10px] font-semibold text-warning-800 dark:bg-warning-500/20 dark:text-warning-300">
                                                    <i class="fa-solid fa-triangle-exclamation mr-1"></i>Avoidable Fee
                                                </span>
                                            }

                                            @if (group.IsPassThrough)
                                            {
                                                <span class="rounded-full bg-indigo-50 px-2 py-0.5 text-[10px] font-medium text-indigo-600 dark:bg-indigo-500/10 dark:text-indigo-400">
                                                    Pass-Through
                                                </span>
                                            }

                                            @if (group.CategoryRemembered && !group.WillRemember)
                                            {
                                                <span class="rounded-full bg-brand-50 px-2 py-0.5 text-[10px] font-medium text-brand-600 dark:bg-brand-500/10 dark:text-brand-400"
                                                      title="You put @group.MerchantName in @group.CategoryName before, so it goes there again.">
                                                    <i class="fa-solid fa-wand-magic-sparkles mr-1"></i>Your category
                                                </span>
                                            }
                                        </div>

                                        <!-- Monthly Breakdown Badges -->
                                        <div class="mt-1.5 flex flex-wrap items-center gap-1.5">
                                            <span class="text-[11px] text-gray-400">@group.TransactionCount tx:</span>
                                            @foreach (var mb in group.MonthlyBreakdowns)
                                            {
                                                <span class="inline-flex items-center rounded-md bg-gray-100 px-1.5 py-0.5 text-[10px] font-medium text-gray-600 dark:bg-white/[0.05] dark:text-gray-400">
                                                    @mb.MonthLabel: @Money(mb.TotalAmount) (@mb.TransactionCount)
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <div class="flex items-center gap-4">
                                    <!-- Bulk Category Reassigner -->
                                    <div class="hidden sm:block">
                                        <select value="@(group.CategoryName ?? "")" @onchange="(e) => ChangeGroupCategory(group, e.Value?.ToString())"
                                                class="rounded-lg border border-gray-200 bg-white py-1 pl-2.5 pr-8 text-xs text-gray-700 focus:border-brand-500 focus:outline-none dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300">
                                            <option value="">Uncategorized</option>
                                            @foreach (var cat in _availableCategories)
                                            {
                                                <option value="@cat.Name">@cat.Name</option>
                                            }
                                        </select>
                                        @if (group.WillRemember)
                                        {
                                            <p class="mt-1 text-[10px] text-brand-600 dark:text-brand-400">
                                                <i class="fa-solid fa-check mr-0.5"></i>Remembered for next time
                                            </p>
                                        }
                                    </div>

                                    <div class="text-right">
                                        <p class="text-sm font-bold @(group.Type == TransactionType.Income ? "text-success-600 dark:text-success-400" : "text-gray-900 dark:text-white")">
                                            @Sign(group.Type)@Money(group.TotalAmount)
                                        </p>
                                        @if (_preview.MonthsCovered > 1)
                                        {
                                            <p class="text-[11px] text-gray-500 dark:text-gray-400">≈ @Money(_preview.PerMonth(group.TotalAmount)) a month</p>
                                        }
                                        <p class="text-[11px] text-gray-400">
                                            @group.IncludedCount of @group.TransactionCount included
                                        </p>
                                    </div>

                                    <button type="button" @onclick="() => ToggleAccordion(group.NormalizedKey)"
                                            class="flex h-8 w-8 items-center justify-center rounded-full text-gray-400 hover:bg-gray-100 hover:text-gray-600 dark:hover:bg-white/[0.05] dark:hover:text-gray-200">
                                        <i class="fa-solid fa-chevron-down transition-transform @(isExpanded ? "rotate-180" : "")"></i>
                                    </button>
                                </div>
                            </div>

                            <!-- Expanded Individual Items Drawer -->
                            @if (isExpanded)
                            {
                                <div class="border-t border-gray-100 bg-gray-50/50 px-6 py-3 dark:border-gray-800 dark:bg-white/[0.01]">
                                    <table class="min-w-full">
                                        <thead>
                                            <tr class="text-[11px] text-gray-400 uppercase">
                                                <th class="py-2 text-left w-10"></th>
                                                <th class="py-2 text-left">Date</th>
                                                <th class="py-2 text-left">Raw Description</th>
                                                <th class="py-2 text-left">Category</th>
                                                <th class="py-2 text-right">Amount</th>
                                            </tr>
                                        </thead>
                                        <tbody class="divide-y divide-gray-100/60 dark:divide-gray-800/60">
                                            @foreach (var item in group.Items)
                                            {
                                                <tr class="text-xs text-gray-700 dark:text-gray-300 @(item.Include ? "" : "opacity-40")">
                                                    <td class="py-2">
                                                        <input type="checkbox" checked="@item.Include" @onchange="() => ToggleCandidate(item)"
                                                               class="h-3.5 w-3.5 rounded border-gray-300 text-brand-500 focus:ring-brand-500 dark:border-gray-600 dark:bg-gray-700" />
                                                    </td>
                                                    <td class="py-2">@item.DateUtc.ToString("dd MMM yyyy")</td>
                                                    <td class="py-2 max-w-xs truncate">
                                                        <span>@item.RawDescription</span>
                                                        @if (!string.IsNullOrEmpty(item.SkipReason))
                                                        {
                                                            <span class="ml-1 text-[10px] text-gray-400">(@item.SkipReason)</span>
                                                        }
                                                    </td>
                                                    <td class="py-2">
                                                        @if (item.Type == TransactionType.Transfer)
                                                        {
                                                            @TransferPicker(item)
                                                        }
                                                        else
                                                        {
                                                        <select value="@(item.CategoryName ?? "")" @onchange="(e) => item.CategoryName = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value.ToString()"
                                                                class="rounded border border-gray-200 bg-white py-0.5 pl-2 pr-7 text-[11px] text-gray-700 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300">
                                                            <option value="">None</option>
                                                            @foreach (var cat in _availableCategories)
                                                            {
                                                                <option value="@cat.Name">@cat.Name</option>
                                                            }
                                                        </select>
                                                        }
                                                    </td>
                                                    <td class="py-2 text-right font-medium">@Money(item.Amount)</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <!-- ===== All Transactions (Ledger) View ===== -->
                <div class="overflow-x-auto">
                    <table class="min-w-full">
                        <thead>
                            <tr class="border-b border-gray-100 dark:border-gray-800">
                                <th class="px-4 py-3 text-left">
                                    <input type="checkbox" checked="@AllNewSelected" @onchange="ToggleAll"
                                           class="h-4 w-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 dark:border-gray-600 dark:bg-gray-700" />
                                </th>
                                <th class="px-4 py-3 text-left text-sm font-medium text-gray-500 dark:text-gray-400">Date</th>
                                <th class="px-4 py-3 text-left text-sm font-medium text-gray-500 dark:text-gray-400">Merchant / Service</th>
                                <th class="px-4 py-3 text-left text-sm font-medium text-gray-500 dark:text-gray-400">Type</th>
                                <th class="px-4 py-3 text-left text-sm font-medium text-gray-500 dark:text-gray-400">Category</th>
                                <th class="px-4 py-3 text-right text-sm font-medium text-gray-500 dark:text-gray-400">Amount</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
                            @foreach (var candidate in FilteredCandidates)
                            {
                                <tr class="transition-colors hover:bg-gray-50 dark:hover:bg-white/[0.02] @(candidate.Include ? "" : "opacity-50")">
                                    <td class="px-4 py-3">
                                        <input type="checkbox" checked="@candidate.Include" @onchange="() => ToggleCandidate(candidate)"
                                               class="h-4 w-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 dark:border-gray-600 dark:bg-gray-700" />
                                    </td>
                                    <td class="px-4 py-3 text-sm text-gray-700 dark:text-gray-300">@candidate.DateUtc.ToString("dd MMM yyyy")</td>
                                    <td class="max-w-[340px] px-4 py-3">
                                        <div class="flex items-center gap-2">
                                            <i class="@candidate.MerchantIcon text-xs text-gray-400"></i>
                                            <p class="truncate text-sm font-medium text-gray-800 dark:text-white/90">@candidate.MerchantName</p>
                                        </div>
                                        <p class="truncate text-[11px] text-gray-400 dark:text-gray-500">@candidate.RawDescription</p>
                                        @if (!string.IsNullOrEmpty(candidate.SkipReason))
                                        {
                                            <p class="text-[10px] text-gray-400 dark:text-gray-500">@candidate.SkipReason</p>
                                        }
                                    </td>
                                    <td class="px-4 py-3">
                                        @if (candidate.Type == TransactionType.Income)
                                        {
                                            <span class="rounded-full bg-success-50 px-2 py-0.5 text-[11px] font-medium text-success-600 dark:bg-success-500/10 dark:text-success-400">Income</span>
                                        }
                                        else if (candidate.Type == TransactionType.Transfer)
                                        {
                                            <span class="rounded-full bg-gray-100 px-2 py-0.5 text-[11px] font-medium text-gray-500 dark:bg-white/[0.05] dark:text-gray-400">Transfer</span>
                                        }
                                        else
                                        {
                                            <span class="rounded-full bg-error-50 px-2 py-0.5 text-[11px] font-medium text-error-600 dark:bg-error-500/10 dark:text-error-400">Expense</span>
                                        }
                                    </td>
                                    <td class="px-4 py-3 text-sm text-gray-500 dark:text-gray-400">
                                        @if (candidate.Type == TransactionType.Transfer)
                                        {
                                            @TransferPicker(candidate)
                                        }
                                        else
                                        {
                                            @(candidate.CategoryName ?? "—")
                                        }
                                    </td>
                                    <td class="px-4 py-3 text-right text-sm font-medium @(candidate.Type == TransactionType.Income ? "text-success-600 dark:text-success-400" : "text-gray-800 dark:text-white/90")">
                                        @Sign(candidate.Type)@Money(candidate.Amount)
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    @if (FilteredCandidates.Count() > MaxPreviewRows)
                    {
                        <div class="border-t border-gray-100 px-6 py-3 text-center dark:border-gray-800">
                            <button type="button" @onclick="() => _showAllRows = !_showAllRows"
                                    class="text-sm font-medium text-brand-500 hover:text-brand-600">
                                @(_showAllRows ? "Show first rows only" : $"Show all {FilteredCandidates.Count()} rows")
                            </button>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

<UpdateBalanceModal @bind-IsOpen="_showUpdateBalanceModal" OnBalanceSaved="OnBalanceSavedAsync" />

@code {
    private enum ViewMode { Grouped, Ledger }

    private const int MaxPreviewRows = 300;

    private ViewMode _viewMode = ViewMode.Grouped;
    private string? _currency;
    private string? _error;
    private bool _isParsing;
    private bool _isImporting;
    private bool _showAllRows;
    private bool _showUpdateBalanceModal;

    private string _searchTerm = "";
    private string _typeFilter = "All";

    private StatementImportPreview? _preview;
    private StatementImportResult? _result;
    private readonly List<StatementImport> _history = [];
    private List<Account> _accounts = [];
    private AccountType _newAccountType = AccountType.Cheque;
    private readonly List<Category> _availableCategories = [];
    private readonly HashSet<string> _expandedGroups = [];
    private CashFlowProjection? _projection;
    private readonly List<MonthChartPoint> _chartData = [];

    private sealed class MonthChartPoint
    {
        public string Label { get; set; } = "";
        public decimal Income { get; set; }
        public decimal Expenses { get; set; }
    }

    private int SelectedCount => _preview?.Candidates.Count(c => c.Include) ?? 0;

    private bool AllNewSelected => _preview is not null
        && _preview.Candidates.Any(CanInclude)
        && _preview.Candidates.All(c => c.Include || !CanInclude(c));

    /// <summary>A row can be ticked unless it's already in the app, or it's a transfer with no other account yet.</summary>
    private static bool CanInclude(ImportCandidate candidate)
        => !candidate.AlreadyExists && (candidate.Type != TransactionType.Transfer || candidate.CounterAccountId is not null);

    private IEnumerable<GroupedMerchantCandidate> FilteredGroups
    {
        get
        {
            if (_preview is null) return [];
            var query = _preview.GroupedMerchants.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                query = query.Where(g => g.MerchantName.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)
                                         || g.Items.Any(i => i.RawDescription?.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            if (_typeFilter == "Expense")
            {
                query = query.Where(g => g.Type == TransactionType.Expense);
            }
            else if (_typeFilter == "Income")
            {
                query = query.Where(g => g.Type == TransactionType.Income);
            }
            else if (_typeFilter == "Transfer")
            {
                query = query.Where(g => g.Type == TransactionType.Transfer);
            }
            else if (_typeFilter == "AvoidableFees")
            {
                query = query.Where(g => g.IsAvoidableFee);
            }

            return query;
        }
    }

    private IEnumerable<ImportCandidate> FilteredCandidates
    {
        get
        {
            if (_preview is null) return [];
            var query = _preview.Candidates.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                query = query.Where(c => c.MerchantName.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)
                                         || (c.RawDescription?.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            if (_typeFilter == "Expense")
            {
                query = query.Where(c => c.Type == TransactionType.Expense);
            }
            else if (_typeFilter == "Income")
            {
                query = query.Where(c => c.Type == TransactionType.Income);
            }
            else if (_typeFilter == "Transfer")
            {
                query = query.Where(c => c.Type == TransactionType.Transfer);
            }
            else if (_typeFilter == "AvoidableFees")
            {
                query = query.Where(c => c.IsAvoidableFee);
            }

            return _showAllRows ? query : query.Take(MaxPreviewRows);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var settings = await SettingsService.GetAsync();
        _currency = settings.Currency;

        _availableCategories.Clear();
        _availableCategories.AddRange(await CategoryService.GetAllAsync());

        await ReloadDataAsync();
    }

    private async Task OnBalanceSavedAsync()
    {
        await ReloadDataAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ReloadDataAsync()
    {
        await ImportService.ReconcileAppWithBankDataAsync();
        _accounts = (await AccountService.GetBalancesAsync()).Select(b => b.Account).ToList();

        _history.Clear();
        _history.AddRange(await ImportService.GetImportHistoryAsync());

        _projection = await ProjectionService.BuildProjectionAsync();
        RebuildChart();
    }

    private void RebuildChart()
    {
        _chartData.Clear();

        if (_projection is null)
        {
            return;
        }

        foreach (var month in _projection.History)
        {
            _chartData.Add(new MonthChartPoint
            {
                Label = month.Month.ToString("MMM yy"),
                Income = month.Income,
                Expenses = month.Expenses
            });
        }

        if (_projection.History.Count > 0)
        {
            _chartData.Add(new MonthChartPoint
            {
                Label = "Projected",
                Income = _projection.ProjectedMonthlyIncome,
                Expenses = _projection.ProjectedMonthlyExpenses
            });
        }
    }

    private async Task OnFilesSelectedAsync(InputFileChangeEventArgs e)
    {
        _error = null;
        _isParsing = true;

        try
        {
            var files = e.GetMultipleFiles(10);
            var previews = new List<StatementImportPreview>();
            var skipped = new List<string>();

            foreach (var file in files)
            {
                if (!file.Name.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase)
                    && !file.Name.EndsWith(".csv", StringComparison.OrdinalIgnoreCase)
                    && !file.Name.EndsWith(".ofx", StringComparison.OrdinalIgnoreCase)
                    && !file.Name.EndsWith(".qfx", StringComparison.OrdinalIgnoreCase))
                {
                    skipped.Add($"Skipped \"{file.Name}\" — use an FNB PDF statement or a CSV/OFX transaction-history download.");
                    continue;
                }

                await using var stream = file.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024);
                using var buffer = new MemoryStream();
                await stream.CopyToAsync(buffer);
                buffer.Position = 0;

                var preview = await ImportService.BuildPreviewAsync(buffer, file.Name);

                if (preview is null)
                {
                    skipped.Add($"Could not read \"{file.Name}\". Use an FNB statement PDF or a CSV/OFX transaction history download.");
                    continue;
                }

                previews.Add(preview);
            }

            if (previews.Count > 0)
            {
                _preview = await ImportService.MergePreviewsAsync(previews);
                _result = null;
                _showAllRows = false;
                _expandedGroups.Clear();
            }

            if (skipped.Count > 0)
            {
                _error = string.Join(" ", skipped);
            }
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        catch (Exception ex)
        {
            _error = $"Failed to read the file: {ex.Message}";
        }
        finally
        {
            _isParsing = false;
        }
    }


    private void ToggleAccordion(string key)
    {
        if (_expandedGroups.Contains(key))
        {
            _expandedGroups.Remove(key);
        }
        else
        {
            _expandedGroups.Add(key);
        }
    }

    private void ToggleGroup(GroupedMerchantCandidate group)
    {
        var targetValue = !group.AllIncluded;
        foreach (var item in group.Items.Where(CanInclude))
        {
            item.Include = targetValue;
        }
    }

    private void ChangeGroupCategory(GroupedMerchantCandidate group, string? categoryName)
    {
        var normalized = string.IsNullOrWhiteSpace(categoryName) ? null : categoryName;
        group.CategoryName = normalized;
        foreach (var item in group.Items)
        {
            item.CategoryName = normalized;
        }
    }

    private void ToggleCandidate(ImportCandidate candidate)
    {
        if (!CanInclude(candidate))
        {
            return;
        }

        candidate.Include = !candidate.Include;
    }

    private void ToggleAll()
    {
        if (_preview is null)
        {
            return;
        }

        var newValue = !AllNewSelected;

        foreach (var candidate in _preview.Candidates.Where(CanInclude))
        {
            candidate.Include = newValue;
        }
    }

    private int? MainAccountId => _accounts.FirstOrDefault(a => a.IsDefault)?.Id;

    private string AccountName(int? accountId)
        => _accounts.FirstOrDefault(a => a.Id == (accountId ?? MainAccountId))?.Name ?? "Archived account";

    private static string Sign(TransactionType type) => type switch
    {
        TransactionType.Income => "+",
        TransactionType.Expense => "-",
        _ => ""
    };

    private async Task ChangePreviewAccountAsync(string? value)
    {
        if (_preview is null || !int.TryParse(value, out var accountId))
        {
            return;
        }

        _preview.AccountId = accountId;

        // A transfer can't go to the account it comes from.
        foreach (var candidate in _preview.Candidates.Where(c => c.CounterAccountId == accountId))
        {
            candidate.CounterAccountId = null;
        }

        await ImportService.RefreshAsync(_preview);
    }

    /// <summary>Adds the statement's account, holding its closing balance as of the statement's end.</summary>
    private async Task AddStatementAccountAsync()
    {
        if (_preview is null)
        {
            return;
        }

        var number = AccountDisplay.MaskedNumber(_preview.AccountNumber);
        var asOf = _preview.ClosingBalance is not null && _preview.PeriodEndUtc is { } end
            ? end.Date.AddDays(1).AddTicks(-1)
            : _preview.PeriodStartUtc?.Date.AddTicks(-1) ?? DateTime.UtcNow;

        try
        {
            var account = await AccountService.CreateAsync(new Account
            {
                Name = number is null ? AccountDisplay.Label(_newAccountType) : $"{AccountDisplay.Label(_newAccountType)} {number}",
                Type = _newAccountType,
                AccountNumber = _preview.AccountNumber,
                Balance = _preview.ClosingBalance ?? 0m,
                BalanceAsOfUtc = asOf
            });

            _accounts = (await AccountService.GetBalancesAsync()).Select(b => b.Account).ToList();
            await ChangePreviewAccountAsync(account.Id.ToString());
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
    }

    private async Task ChangeTransferAccountAsync(ImportCandidate candidate, string? value)
    {
        if (_preview is null)
        {
            return;
        }

        candidate.CounterAccountId = int.TryParse(value, out var accountId) ? accountId : null;
        candidate.Include = candidate.CounterAccountId is not null;
        await ImportService.RefreshAsync(_preview);
    }

    private async Task MoveImportAsync(int importId, string? value)
    {
        if (!int.TryParse(value, out var accountId))
        {
            return;
        }

        try
        {
            await ImportService.MoveImportAsync(importId, accountId);
            await ReloadDataAsync();
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
    }

    /// <summary>The person's other account for a transfer: where money out of this account went, or where money in came from.</summary>
    private RenderFragment TransferPicker(ImportCandidate candidate) => __builder =>
    {
        <select value="@(candidate.CounterAccountId?.ToString() ?? "")" @onchange="e => ChangeTransferAccountAsync(candidate, e.Value?.ToString())"
                disabled="@candidate.AlreadyExists"
                class="rounded border border-gray-200 bg-white py-0.5 pl-2 pr-7 text-[11px] text-gray-700 disabled:opacity-60 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300">
            <option value="">@(candidate.IsCredit ? "From which account?" : "To which account?")</option>
            @foreach (var account in _accounts.Where(a => a.Id != _preview?.AccountId))
            {
                <option value="@account.Id">@(candidate.IsCredit ? "From" : "To") @account.Name</option>
            }
        </select>
    };

    private async Task ImportAsync()
    {
        if (_preview is null)
        {
            return;
        }

        _isImporting = true;
        _error = null;

        try
        {
            _result = await ImportService.ImportAsync(_preview);
            _preview = null;

            GameFeedbackService.Trigger(new FeedbackPayload(
                0,
                $"Statement imported — {_result.ImportedCount} transactions added",
                FeedbackKind.Positive));

            await ReloadDataAsync();
        }
        catch (Exception ex)
        {
            _error = $"Import failed: {ex.Message}";
        }
        finally
        {
            _isImporting = false;
        }
    }

    private async Task RevertImportAsync(int importId)
    {
        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            "Revert this import? Its transactions, and the subscriptions and buckets it created, will be deleted.");
        if (!confirmed)
        {
            return;
        }

        var removed = await ImportService.RevertImportAsync(importId);

        if (removed.TransactionsRemoved + removed.SubscriptionsRemoved + removed.BucketsRemoved > 0)
        {
            var extras = new List<string>();
            if (removed.SubscriptionsRemoved > 0) extras.Add($"{removed.SubscriptionsRemoved} subscription(s)");
            if (removed.BucketsRemoved > 0) extras.Add($"{removed.BucketsRemoved} bucket(s)");

            GameFeedbackService.Trigger(new FeedbackPayload(
                0,
                $"Import reverted — {removed.TransactionsRemoved} transactions removed"
                + (extras.Count > 0 ? $", plus {string.Join(" and ", extras)}" : ""),
                FeedbackKind.Normal));

            await ReloadDataAsync();
        }
    }

    private void Reset()
    {
        _preview = null;
        _result = null;
        _error = null;
        _showAllRows = false;
        _expandedGroups.Clear();
    }

    private string Money(decimal amount)
    {
        return CurrencyFormatting.FormatCurrency(amount, _currency ?? "ZAR");
    }
}
