<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:CoinStack.Desktop.ViewModels"
             x:Class="CoinStack.Desktop.Views.TransactionsView"
             x:DataType="viewModels:TransactionsViewModel">
    <ScrollViewer Padding="0,0,0,20">
        <StackPanel Spacing="20">
            <Grid ColumnDefinitions="*, Auto">
                <TextBlock Text="Transactions" Classes="h1" VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button Grid.Column="1" Classes="primary" VerticalAlignment="Center">+ Log Expense</Button>
            </Grid>

            <Border Classes="Card">
                <StackPanel Spacing="12">
                    <TextBlock Text="Recent Transactions" Classes="h2" TextWrapping="Wrap" />
                    
                    <!-- Transactions List -->
                    <ItemsControl ItemsSource="{Binding Transactions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,10" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                        <!-- Left: Date -->
                                        <StackPanel Width="80">
                                            <TextBlock Text="{Binding Date, StringFormat='MMM dd'}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Date, StringFormat='yyyy'}" FontSize="11" Foreground="#9CA3AF" />
                                        </StackPanel>
                                        
                                        <!-- Middle: Description and Category -->
                                        <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="4">
                                            <TextBlock Text="{Binding Description}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Category}" FontSize="12" Foreground="#6B7280" />
                                        </StackPanel>
                                        
                                        <!-- Right: Amount and Type -->
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" Spacing="4">
                                            <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" HorizontalAlignment="Right">
                                                <Run Text="{Binding Amount, StringFormat='${0:F2}'}" Foreground="#1976D2" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Type}" FontSize="11" Foreground="#9CA3AF" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>