<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CoinStack.Desktop.ViewModels"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             x:Class="CoinStack.Desktop.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
    <StackPanel Spacing="24">
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Dashboard" Classes="PageTitle" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <i:Icon Value="fa-solid fa-star" FontSize="14" />
                <TextBlock Text="{Binding TotalScore, StringFormat='Score {0}'}" Classes="body" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <TextBlock Text="{Binding StatusMessage}" Classes="body" IsVisible="{Binding StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="16">
            <Border Classes="StatCard" Grid.Column="3">
                <StackPanel Spacing="8">
                    <TextBlock Text="Money in the bank" Classes="body" />
                    <TextBlock Text="{Binding BankBalanceText}" Classes="Money"
                               Foreground="{Binding IsOverdrawn, Converter={StaticResource BoolToStatusBrushConverter}, ConverterParameter=invert}" />
                    <TextBlock Text="Your cheque accounts" Classes="body" FontSize="12" />
                </StackPanel>
            </Border>

            <Border Classes="StatCard" Grid.Column="0">
                <StackPanel Spacing="8">
                    <TextBlock Text="Budget remaining" Classes="body" />
                    <TextBlock Text="{Binding BudgetRemainingText}" Classes="Money"
                               Foreground="{Binding IsOverBudget, Converter={StaticResource BoolToStatusBrushConverter}, ConverterParameter=invert}" />
                    <ProgressBar Classes="pill"
                                 Value="{Binding BudgetProgress}"
                                 Maximum="{Binding BudgetProgressMax}" />
                    <TextBlock Classes="body" FontSize="12">
                        <Run Text="{Binding BudgetSpentText, Mode=OneWay}" />
                        <Run Text=" of " />
                        <Run Text="{Binding BudgetLimitText, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Classes="StatCard" Grid.Column="1">
                <StackPanel Spacing="8">
                    <TextBlock Text="Reserves total" Classes="body" />
                    <TextBlock Text="{Binding ReservesTotalText}" Classes="Money" />
                    <TextBlock Text="{Binding SavingsAvailableText, StringFormat='Available {0}'}" Classes="body" FontSize="12" />
                </StackPanel>
            </Border>

            <Border Classes="StatCard" Grid.Column="2">
                <StackPanel Spacing="8">
                    <TextBlock Text="Emergency fund" Classes="body" />
                    <TextBlock Text="{Binding EmergencyFundText}" Classes="Money" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
            <Border Classes="Card" Grid.Column="0">
                <StackPanel Spacing="12">
                    <TextBlock Text="Recent transactions" Classes="h2" />
                    <ItemsControl ItemsSource="{Binding RecentTransactions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TransactionRow">
                                <Border Padding="0,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Description}" FontWeight="Medium" />
                                            <TextBlock Classes="body" FontSize="12">
                                                <Run Text="{Binding DateText, Mode=OneWay}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding Category, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding AmountText}"
                                                   Classes="MoneySm"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding IsIncome, Converter={StaticResource BoolToStatusBrushConverter}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Classes="Card" Grid.Column="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="Recent score activity" Classes="h2" />
                    <ItemsControl ItemsSource="{Binding RecentScoreEvents}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ScoreEventRow">
                                <Border Padding="0,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Description}" />
                                            <TextBlock Text="{Binding DateText}" Classes="body" FontSize="12" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding PointsText}"
                                                   Classes="MoneySm"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding IsPositive, Converter={StaticResource BoolToStatusBrushConverter}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
