<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CoinStack.Desktop.ViewModels"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             x:Class="CoinStack.Desktop.Views.ReportsView"
             x:DataType="vm:ReportsViewModel">
    <StackPanel Spacing="24">
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Reports" Classes="PageTitle" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <i:Icon Value="fa-solid fa-chart-line" FontSize="14" />
                <TextBlock Text="{Binding PeriodLabel}" Classes="body" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <TextBlock Text="{Binding StatusMessage}" Classes="body"
                   IsVisible="{Binding StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <TextBlock Text="Current month" Classes="h2" />
        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
            <Border Classes="StatCard">
                <StackPanel Spacing="6">
                    <TextBlock Text="Income" Classes="body" />
                    <TextBlock Text="{Binding PeriodIncomeText}" Classes="Money"
                               Foreground="{DynamicResource SuccessBrush}" />
                </StackPanel>
            </Border>
            <Border Classes="StatCard" Grid.Column="1">
                <StackPanel Spacing="6">
                    <TextBlock Text="Expenses" Classes="body" />
                    <TextBlock Text="{Binding PeriodExpenseText}" Classes="Money"
                               Foreground="{DynamicResource DangerBrush}" />
                </StackPanel>
            </Border>
            <Border Classes="StatCard" Grid.Column="2">
                <StackPanel Spacing="6">
                    <TextBlock Text="Net" Classes="body" />
                    <TextBlock Text="{Binding PeriodNetText}" Classes="Money"
                               Foreground="{Binding PeriodNetPositive, Converter={StaticResource BoolToStatusBrushConverter}}" />
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Text="Lifetime" Classes="h2" />
        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="16">
            <Border Classes="StatCard">
                <StackPanel Spacing="6">
                    <TextBlock Text="Income" Classes="body" />
                    <TextBlock Text="{Binding LifetimeIncomeText}" Classes="Money"
                               Foreground="{DynamicResource SuccessBrush}" />
                </StackPanel>
            </Border>
            <Border Classes="StatCard" Grid.Column="1">
                <StackPanel Spacing="6">
                    <TextBlock Text="Expenses" Classes="body" />
                    <TextBlock Text="{Binding LifetimeExpenseText}" Classes="Money"
                               Foreground="{DynamicResource DangerBrush}" />
                </StackPanel>
            </Border>
            <Border Classes="StatCard" Grid.Column="2">
                <StackPanel Spacing="6">
                    <TextBlock Text="Net" Classes="body" />
                    <TextBlock Text="{Binding LifetimeNetText}" Classes="Money"
                               Foreground="{Binding LifetimeNetPositive, Converter={StaticResource BoolToStatusBrushConverter}}" />
                </StackPanel>
            </Border>
            <Border Classes="StatCard" Grid.Column="3">
                <StackPanel Spacing="6">
                    <TextBlock Text="Savings available" Classes="body" />
                    <TextBlock Text="{Binding SavingsAvailableText}" Classes="Money" />
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
