<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CoinStack.Desktop.ViewModels"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             x:Class="CoinStack.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <StackPanel Spacing="24">
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Settings" Classes="PageTitle" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="primary" Command="{Binding SaveCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <i:Icon Value="fa-solid fa-floppy-disk" FontSize="12" />
                    <TextBlock Text="Save changes" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <TextBlock Text="{Binding StatusMessage}" Classes="body"
                   IsVisible="{Binding StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <Border Classes="Card">
            <StackPanel Spacing="16">
                <TextBlock Text="Budget preferences" Classes="h2" />
                <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto"
                      ColumnSpacing="16" RowSpacing="12">
                    <TextBlock Text="Currency" VerticalAlignment="Center" Classes="body" />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding Currencies}"
                              SelectedItem="{Binding Currency}" />

                    <TextBlock Grid.Row="1" Text="Payday" VerticalAlignment="Center" Classes="body" />
                    <ComboBox Grid.Row="1" Grid.Column="1"
                              ItemsSource="{Binding StartDays}"
                              SelectedItem="{Binding MonthStartDay}" />

                    <TextBlock Grid.Row="2" Text="Monthly income" VerticalAlignment="Center" Classes="body" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding MonthlyIncome}" />

                    <TextBlock Grid.Row="3" Text="Current bank balance" VerticalAlignment="Center" Classes="body" />
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding CurrentBankBalance}" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Classes="Card">
            <StackPanel Spacing="16">
                <TextBlock Text="Reserves &amp; behavior" Classes="h2" />
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                      ColumnSpacing="16" RowSpacing="10">
                    <TextBlock Text="Reserve-aware budget" Classes="body" VerticalAlignment="Center" />
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowReserveAwareBudget}" />

                    <TextBlock Grid.Row="1" Text="Emergency fund fallback" Classes="body" VerticalAlignment="Center" />
                    <ToggleSwitch Grid.Row="1" Grid.Column="1" IsChecked="{Binding EnableEmergencyFallback}" />

                    <TextBlock Grid.Row="2" Text="Enable scoring" Classes="body" VerticalAlignment="Center" />
                    <ToggleSwitch Grid.Row="2" Grid.Column="1" IsChecked="{Binding EnableScoring}" />

                    <TextBlock Grid.Row="3" Text="Enable streaks" Classes="body" VerticalAlignment="Center" />
                    <ToggleSwitch Grid.Row="3" Grid.Column="1" IsChecked="{Binding EnableStreaks}" />

                    <TextBlock Grid.Row="4" Text="Enable toasts" Classes="body" VerticalAlignment="Center" />
                    <ToggleSwitch Grid.Row="4" Grid.Column="1" IsChecked="{Binding EnableToast}" />

                    <TextBlock Grid.Row="5" Text="Enable sounds" Classes="body" VerticalAlignment="Center" />
                    <ToggleSwitch Grid.Row="5" Grid.Column="1" IsChecked="{Binding EnableSounds}" />

                    <TextBlock Grid.Row="6" Text="Enable reflections" Classes="body" VerticalAlignment="Center" />
                    <ToggleSwitch Grid.Row="6" Grid.Column="1" IsChecked="{Binding EnableReflections}" />
                </Grid>

                <Grid ColumnDefinitions="180,*" ColumnSpacing="16" Margin="0,8,0,0">
                    <TextBlock Text="Large expense threshold" Classes="body" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding LargeExpenseThreshold}" />
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
