<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CoinStack.Desktop.ViewModels"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             x:Class="CoinStack.Desktop.Views.IncomeView"
             x:DataType="vm:IncomeViewModel">
    <StackPanel Spacing="24">
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Income" Classes="PageTitle" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <i:Icon Value="fa-solid fa-arrow-trend-up" FontSize="14" />
                <TextBlock Text="{Binding PeriodLabel}" Classes="body" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <TextBlock Text="{Binding StatusMessage}" Classes="body"
                   IsVisible="{Binding StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
            <Border Classes="StatCard">
                <StackPanel Spacing="6">
                    <TextBlock Text="Monthly income (settings)" Classes="body" />
                    <TextBlock Text="{Binding MonthlyIncomeText}" Classes="Money" />
                </StackPanel>
            </Border>
            <Border Classes="StatCard" Grid.Column="1">
                <StackPanel Spacing="6">
                    <TextBlock Text="Received this period" Classes="body" />
                    <TextBlock Text="{Binding PeriodIncomeText}" Classes="Money"
                               Foreground="{DynamicResource SuccessBrush}" />
                </StackPanel>
            </Border>
            <Border Classes="StatCard" Grid.Column="2">
                <StackPanel Spacing="6">
                    <TextBlock Text="Lifetime income" Classes="body" />
                    <TextBlock Text="{Binding LifetimeIncomeText}" Classes="Money"
                               Foreground="{DynamicResource SuccessBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Classes="Card">
            <StackPanel Spacing="12">
                <TextBlock Text="Income transactions" Classes="h2" />
                <ItemsControl ItemsSource="{Binding IncomeTransactions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TransactionRow">
                            <Border Padding="0,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Description}" FontWeight="Medium" />
                                        <TextBlock Classes="body" FontSize="12">
                                            <Run Text="{Binding DateText, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding Category, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding AmountText}"
                                               Classes="MoneySm"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource SuccessBrush}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
