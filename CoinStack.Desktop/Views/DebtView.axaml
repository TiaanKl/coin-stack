<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CoinStack.Desktop.ViewModels"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             x:Class="CoinStack.Desktop.Views.DebtView"
             x:DataType="vm:DebtViewModel">
    <StackPanel Spacing="24">
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="Debt accounts" Classes="PageTitle" />
                <TextBlock Text="Track balances and estimate a fixed monthly repayment." Classes="body" />
            </StackPanel>
            <Button Grid.Column="1" Classes="primary" Command="{Binding AddDebtCommand}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <i:Icon Value="fa-solid fa-plus" FontSize="12" />
                    <TextBlock Text="Save debt" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <TextBlock Text="{Binding StatusMessage}" Classes="body"
                   IsVisible="{Binding StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
            <Border Classes="StatCard">
                <StackPanel Spacing="6">
                    <TextBlock Text="Open debts" Classes="body" />
                    <TextBlock Text="{Binding OpenDebtCount}" Classes="Money" />
                </StackPanel>
            </Border>
            <Border Classes="StatCard" Grid.Column="1">
                <StackPanel Spacing="6">
                    <TextBlock Text="Total owed" Classes="body" />
                    <TextBlock Text="{Binding TotalOwedText}" Classes="Money"
                               Foreground="{DynamicResource DangerBrush}" />
                </StackPanel>
            </Border>
            <Border Classes="StatCard" Grid.Column="2">
                <StackPanel Spacing="6">
                    <TextBlock Text="Monthly payments" Classes="body" />
                    <TextBlock Text="{Binding MonthlyPaymentTotalText}" Classes="Money" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
            <!-- Add form -->
            <Border Classes="Card">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="New debt account" Classes="h2" />
                        <TextBlock Text="Save the account you still owe. Use the calculator on the right if you need a payment estimate."
                                   Classes="body" TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Name" Classes="body" FontSize="12" />
                            <TextBox PlaceholderText="e.g. Car loan" Text="{Binding NewDebtName}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="Provider" Classes="body" FontSize="12" />
                            <TextBox PlaceholderText="e.g. Bank name" Text="{Binding NewProvider}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Spacing="6">
                            <TextBlock Text="Current balance" Classes="body" FontSize="12" />
                            <NumericUpDown Minimum="0" FormatString="0.00" Value="{Binding NewBalance}"
                                           HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                            <TextBlock Text="Original total" Classes="body" FontSize="12" />
                            <NumericUpDown Minimum="0" FormatString="0.00" Value="{Binding NewTotal}"
                                           HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Spacing="6">
                            <TextBlock Text="Interest rate (%)" Classes="body" FontSize="12" />
                            <NumericUpDown Minimum="0" Maximum="100" FormatString="0.##" Value="{Binding NewInterestRate}"
                                           HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="6">
                            <TextBlock Text="Monthly payment" Classes="body" FontSize="12" />
                            <NumericUpDown Minimum="0" FormatString="0.00" Value="{Binding NewMonthlyPayment}"
                                           HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <Button Grid.Row="3" Grid.ColumnSpan="2"
                                Classes="primary"
                                Command="{Binding AddDebtCommand}"
                                HorizontalAlignment="Left"
                                Content="Save debt account" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Calculator helper -->
            <Border Classes="Card" Grid.Column="1">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Payment calculator" Classes="h2" />
                        <TextBlock Text="Estimate a fixed monthly payment, then copy it into the form."
                                   Classes="body" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Principal" Classes="body" FontSize="12" />
                        <NumericUpDown Minimum="0" FormatString="0.00" Value="{Binding CalcPrincipal}"
                                       HorizontalAlignment="Stretch" />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Interest rate (%)" Classes="body" FontSize="12" />
                            <NumericUpDown Minimum="0" Maximum="100" FormatString="0.##" Value="{Binding CalcInterestRate}"
                                           HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="Term (months)" Classes="body" FontSize="12" />
                            <NumericUpDown Minimum="1" Maximum="600" FormatString="0" Value="{Binding CalcTermMonths}"
                                           HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="primary" Command="{Binding CalculateCommand}" Content="Calculate" />
                        <Button Classes="secondary" Command="{Binding ApplyCalculationToFormCommand}" Content="Use in form" />
                    </StackPanel>

                    <Border Background="{DynamicResource SurfaceMutedBrush}"
                            CornerRadius="16"
                            Padding="16"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{Binding CalcSummary}" Classes="body" TextWrapping="Wrap" />
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Payment" Classes="body" FontSize="11" />
                                    <TextBlock Text="{Binding CalcPaymentText}" Classes="MoneySm" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Total owed" Classes="body" FontSize="11" />
                                    <TextBlock Text="{Binding CalcTotalText}" Classes="MoneySm" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="2">
                                    <TextBlock Text="Interest" Classes="body" FontSize="11" />
                                    <TextBlock Text="{Binding CalcInterestText}" Classes="MoneySm" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <Border Classes="Card" IsVisible="{Binding !HasDebts}">
            <StackPanel Spacing="8" HorizontalAlignment="Center" Margin="0,28">
                <i:Icon Value="fa-solid fa-credit-card" FontSize="28"
                        Foreground="{DynamicResource TextMutedBrush}"
                        HorizontalAlignment="Center" />
                <TextBlock Text="No debt accounts yet" Classes="h2" HorizontalAlignment="Center" />
                <TextBlock Text="Add a loan or card balance above to start tracking payoff progress."
                           Classes="body" HorizontalAlignment="Center" TextAlignment="Center" />
            </StackPanel>
        </Border>

        <Border Classes="Card" IsVisible="{Binding HasDebts}">
            <StackPanel Spacing="16">
                <TextBlock Text="Your debts" Classes="h2" />
                <ItemsControl ItemsSource="{Binding Debts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DebtRow">
                            <Border Padding="0,16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding Provider}" Classes="body" FontSize="12" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Right">
                                            <TextBlock Text="Balance" Classes="body" FontSize="11" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding BalanceText}" Classes="MoneySm"
                                                       Foreground="{DynamicResource DangerBrush}"
                                                       HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,Auto">
                                        <ProgressBar Classes="pill"
                                                     Value="{Binding ProgressValue}"
                                                     Maximum="{Binding ProgressMaximum}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ProgressPercentText}"
                                                   Classes="body" FontSize="12"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </Grid>

                                    <Grid ColumnDefinitions="*,*,*">
                                        <TextBlock Classes="body" FontSize="12"
                                                   Text="{Binding TotalText, StringFormat='Original {0}'}" />
                                        <TextBlock Classes="body" FontSize="12" Grid.Column="1"
                                                   Text="{Binding InterestText}" />
                                        <TextBlock Classes="body" FontSize="12" Grid.Column="2"
                                                   Text="{Binding PaymentText, StringFormat='{}{0} / mo'}"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
