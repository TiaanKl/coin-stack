<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CoinStack.Desktop.ViewModels"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             x:Class="CoinStack.Desktop.Views.SubscriptionsView"
             x:DataType="vm:SubscriptionsViewModel">
    <StackPanel Spacing="24">
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Subscriptions" Classes="PageTitle" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="primary" Command="{Binding AddSubscriptionCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <i:Icon Value="fa-solid fa-plus" FontSize="12" />
                    <TextBlock Text="Add subscription" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <TextBlock Text="{Binding StatusMessage}" Classes="body"
                   IsVisible="{Binding StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
            <Border Classes="StatCard">
                <StackPanel Spacing="6">
                    <TextBlock Text="Active" Classes="body" />
                    <TextBlock Text="{Binding ActiveCount}" Classes="Money" />
                </StackPanel>
            </Border>
            <Border Classes="StatCard" Grid.Column="1">
                <StackPanel Spacing="6">
                    <TextBlock Text="Est. monthly cost" Classes="body" />
                    <TextBlock Text="{Binding MonthlyTotalText}" Classes="Money" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Classes="Card">
            <StackPanel Spacing="12">
                <TextBlock Text="New subscription" Classes="h2" />
                <Grid ColumnDefinitions="2*,*,Auto,Auto,Auto,Auto" ColumnSpacing="12">
                    <TextBox PlaceholderText="Name" Text="{Binding NewName}" />
                    <ComboBox Grid.Column="1"
                              MinWidth="140"
                              PlaceholderText="Category"
                              ItemsSource="{Binding CategoryOptions}"
                              SelectedItem="{Binding SelectedCategory}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:CategoryOption">
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <NumericUpDown Grid.Column="2" Width="168" Minimum="0"
                                   FormatString="0.00"
                                   Value="{Binding NewCost}" />
                    <ComboBox Grid.Column="3" MinWidth="120"
                              ItemsSource="{Binding CycleOptions}"
                              SelectedItem="{Binding NewCycle}" />
                    <ComboBox Grid.Column="4" MinWidth="110"
                              ItemsSource="{Binding StatusOptions}"
                              SelectedItem="{Binding NewStatus}" />
                    <Button Grid.Column="5" Classes="secondary" Command="{Binding AddSubscriptionCommand}" Content="Create" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Classes="Card">
            <StackPanel Spacing="12">
                <TextBlock Text="All subscriptions" Classes="h2" />
                <TextBlock Text="No subscriptions yet." Classes="body"
                           IsVisible="{Binding !HasSubscriptions}" />
                <ItemsControl ItemsSource="{Binding Subscriptions}"
                              IsVisible="{Binding HasSubscriptions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SubscriptionRow">
                            <Border Padding="0,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Classes="body" FontSize="12">
                                            <Run Text="{Binding Category, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding StatusText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="24,0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CycleText}" Classes="body" FontSize="12" />
                                        <TextBlock Text="{Binding DebitDayText}" Classes="body" FontSize="11" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding CostText}"
                                               Classes="MoneySm"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
