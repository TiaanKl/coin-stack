<!-- File: CoinStack.Desktop/Views/GoalsView.axaml -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:CoinStack.Desktop.ViewModels"
             x:Class="CoinStack.Desktop.Views.GoalsView"
             x:DataType="viewModels:GoalsViewModel">
    <StackPanel Spacing="20">
        <Grid ColumnDefinitions="*, Auto">
            <TextBlock Text="Goals" Classes="h1" />
            <Button Classes="primary" Grid.Column="1">+ Create Goal</Button>
        </Grid>
        
        <ItemsControl ItemsSource="{Binding Goals}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Classes="Card" Margin="0,0,0,12">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{Binding Name}" Classes="h2" />
                            <TextBlock Text="{Binding TargetDate, StringFormat='Target: {0:MMM yyyy}'}" Classes="body" />
                            <ProgressBar Value="{Binding Progress}" Height="8" CornerRadius="4" Foreground="{DynamicResource PrimaryBrush}" />
                            <Grid ColumnDefinitions="*, *">
                                <TextBlock Text="{Binding Current, StringFormat='${0:F2}'}" />
                                <TextBlock Text="{Binding Target, StringFormat='/ ${0:F2}'}" Grid.Column="1" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>